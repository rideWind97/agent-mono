{
  "name": "@agent-mono/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI API server for agent-mono",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@agent-mono/shared": "workspace:*",
    "@google/genai": "^1.0.0",
    "cors": "^2.8.5",
    "deepagents": "^1.8.6",
    "dotenv": "^16.4.0",
    "express": "^5.1.0",
    "openai": "^4.85.0"
  },
  "devDependencies": {
    "@agent-mono/eslint-config": "workspace:*",
    "@agent-mono/typescript-config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
