{
  "name": "@agent-mono/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@agent-mono/shared": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@agent-mono/eslint-config": "workspace:*",
    "@agent-mono/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.5.0"
  }
}
