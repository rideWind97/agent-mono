{
  "name": "@agent-mono/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vite + React + TypeScript web application",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@agent-mono/shared": "workspace:*",
    "@agent-mono/ui": "workspace:*",
    "deepagents": "^1.8.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.5.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@agent-mono/eslint-config": "workspace:*",
    "@agent-mono/typescript-config": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "sass": "^1.98.0",
    "typescript": "^5.5.0",
    "vite": "^8.0.0"
  }
}
