{
  "name": "@agent-mono/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@agent-mono/eslint-config": "workspace:*",
    "@agent-mono/typescript-config": "workspace:*",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@langchain/core": "^1.1.36",
    "@langchain/tavily": "^1.2.0",
    "deepagents": "^1.8.6",
    "langchain": "^1.2.37"
  }
}
