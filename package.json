{
  "name": "agent-mono",
  "version": "0.0.0",
  "private": true,
  "description": "Agent 学习 monorepo — Web + Server 同仓开发",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run build --filter=@agent-mono/shared && turbo run dev --filter=@agent-mono/web --filter=@agent-mono/server",
    "dev:web": "turbo run build --filter=@agent-mono/shared && turbo run dev --filter=@agent-mono/web",
    "dev:server": "turbo run build --filter=@agent-mono/shared && turbo run dev --filter=@agent-mono/server",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,vue,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,vue,json,md,css}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run typecheck lint",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "husky",
    "week1": "pnpm --filter @agent-mono/my-learning week1",
    "week1:curl": "pnpm --filter @agent-mono/my-learning week1:curl",
    "week1:experiments": "pnpm --filter @agent-mono/my-learning week1:experiments",
    "week2": "pnpm --filter @agent-mono/my-learning week2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.19.3",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write"
    ]
  }
}
